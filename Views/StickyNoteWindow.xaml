<Window x:Class="ScreenStickyNotes.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinWidth="280" MinHeight="28"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{Binding BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{Binding HeaderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- タイトルバー -->
                <RowDefinition Height="*"/>    <!-- コンテンツ -->
                <RowDefinition Height="Auto"/> <!-- ステータスバー（編集モード時） -->
            </Grid.RowDefinitions>

            <!-- タイトルバー：折りたたみボタン + 折りたたみ時タイトル -->
            <Grid Grid.Row="0" Height="28" Background="{Binding HeaderBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{Binding FoldIcon}"
                        Margin="2,0,0,0"
                        Style="{StaticResource TitleBarButton}"
                        ToolTip="折りたたみ / 展開"
                        Click="Fold_Click"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding FirstLine}"
                           Visibility="{Binding TitleVisibility}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- コンテンツエリア -->
            <RichTextBox x:Name="ContentBox"
                         Grid.Row="1"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         IsReadOnly="True"
                         Cursor="Arrow"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ContentBox_TextChanged"
                         ContextMenuOpening="ContentBox_ContextMenuOpening"
                         PreviewMouseLeftButtonDown="ContentBox_PreviewMouseDown"
                         MouseMove="ContentBox_MouseMove"
                         LostKeyboardFocus="ContentBox_LostKeyboardFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

            <!-- ステータスバー（編集モード時のみ表示） -->
            <Border x:Name="StatusBar"
                    Grid.Row="2"
                    Background="{Binding HeaderBrush}"
                    Visibility="Collapsed">
                <DockPanel Margin="2,1">
                    <!-- 右端：削除ボタン -->
                    <Button DockPanel.Dock="Right"
                            Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="削除" Click="Close_Click"/>
                    <!-- 左側：操作ボタン群 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="＋" Style="{StaticResource TitleBarButton}"
                                ToolTip="新しい付箋を追加" Click="AddNote_Click"/>
                        <ToggleButton IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                      Style="{StaticResource TitleBarToggle}"
                                      ToolTip="常に最前面"
                                      Content="📌"
                                      Checked="Pin_Changed" Unchecked="Pin_Changed"/>
                        <Button Content="A-" Style="{StaticResource TitleBarButton}"
                                ToolTip="フォントを小さく" Click="FontSmaller_Click"/>
                        <Button Content="A+" Style="{StaticResource TitleBarButton}"
                                ToolTip="フォントを大きく" Click="FontLarger_Click"/>
                        <Button x:Name="FontButton" Content="Aa"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="フォントを変更" Click="Font_Click"/>
                        <Button x:Name="ColorButton" Content="🎨"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="色を変更" Click="Color_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="ScreenStickyNotes.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="280" MinHeight="28"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{Binding BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{Binding HeaderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Grid Grid.Row="0" Background="{Binding HeaderBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 折りたたみボタン（常に表示） -->
                <Button Grid.Column="0" Content="{Binding FoldIcon}"
                        Margin="2,0,0,0"
                        Style="{StaticResource TitleBarButton}"
                        ToolTip="折りたたみ / 展開"
                        Click="Fold_Click"/>

                <!-- 折りたたみ時：1行目テキスト -->
                <TextBlock Grid.Column="1"
                           Text="{Binding FirstLine}"
                           Visibility="{Binding TitleVisibility}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 展開時：編集モードラベル -->
                <TextBlock x:Name="EditModeLabel"
                           Grid.Column="1"
                           Text="✏ 編集中"
                           Visibility="Collapsed"
                           Foreground="White"
                           FontSize="11"
                           Opacity="0.75"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>

                <!-- 展開時：右側ボタン群 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,2,0"
                            Visibility="{Binding ControlsVisibility}">
                    <Button Content="＋" Style="{StaticResource TitleBarButton}"
                            ToolTip="新しい付箋を追加" Click="AddNote_Click"/>
                    <ToggleButton IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                  Style="{StaticResource TitleBarToggle}"
                                  ToolTip="常に最前面"
                                  Content="📌"
                                  Checked="Pin_Changed" Unchecked="Pin_Changed"/>
                    <Button Content="A-" Style="{StaticResource TitleBarButton}"
                            ToolTip="フォントを小さく" Click="FontSmaller_Click"/>
                    <Button Content="A+" Style="{StaticResource TitleBarButton}"
                            ToolTip="フォントを大きく" Click="FontLarger_Click"/>
                    <Button x:Name="FontButton" Content="Aa"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="フォントを変更" Click="Font_Click"/>
                    <Button x:Name="ColorButton" Content="🎨"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="色を変更" Click="Color_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="削除" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- コンテンツエリア -->
            <RichTextBox x:Name="ContentBox"
                         Grid.Row="1"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         IsReadOnly="True"
                         Cursor="Arrow"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ContentBox_TextChanged"
                         ContextMenuOpening="ContentBox_ContextMenuOpening"
                         PreviewMouseLeftButtonDown="ContentBox_PreviewMouseDown"
                         MouseMove="ContentBox_MouseMove"
                         LostFocus="ContentBox_LostFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Grid>
    </Border>
</Window>

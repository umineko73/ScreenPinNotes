<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenPinNotes</AssemblyName>
    <RootNamespace>ScreenPinNotes</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.7</Version>
    <Authors>umineko73</Authors>
    <Product>ScreenPinNotes</Product>
    <Description>Windows 11 向けのデスクトップ付箋アプリ</Description>
    <Copyright>Copyright (C) 2026 umineko73</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/umineko73/ScreenPinNotes</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon は exe の Win32 リソースに埋め込むだけなので、
         タスクトレイから読めるよう WPF リソースとしても持たせる -->
    <Resource Include="app.ico" />
    <PackageReference Include="SkiaSharp" Version="3.119.4-preview.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4-preview.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 初回起動時に作成するサンプル付箋の中身。exe と同じフォルダに
         SampleNotes\ としてコピーし、初回起動時にそこから読み込んで
         notes フォルダへコピーする（SampleNoteFactory.cs 参照）。
         コンパイル対象ではないので None、ビルド・publish のたびに
         最新版へ追従させるため PreserveNewest。 -->
    <None Include="SampleNotes\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateLanguageCatalog" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_TranslationFiles Include="Resources/Strings.*.resx" />
      <EmbeddedResource Include="$(IntermediateOutputPath)languages.txt" LogicalName="ScreenPinNotes.Languages" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)languages.txt"
                      Lines="@(_TranslationFiles->'%(Filename)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>

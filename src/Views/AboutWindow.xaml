<Window x:Class="ScreenStickyNotes.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image x:Name="AppIconImage" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ScreenStickyNotes" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="DescriptionText" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <TextBlock Text="Copyright (C) 2026 umineko73" Margin="0,0,0,4"/>
        <TextBlock x:Name="LicenseText" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Margin="0,0,0,20">
            <Hyperlink x:Name="RepoLink" RequestNavigate="RepoLink_RequestNavigate">
                https://github.com/umineko73/ScreenStickyNotes
            </Hyperlink>
        </TextBlock>

        <Button x:Name="CloseButton" Width="88" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="CloseButton_Click"/>
    </StackPanel>
</Window>

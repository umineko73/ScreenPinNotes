<Window x:Class="ScreenPinNotes.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ScreenPinNotes.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Title="{Binding DisplayTitle}"
        MinWidth="140" MinHeight="28"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        Activated="Window_Activated"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScreenPinNotes;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 編集中は縦線と持ち手を隠し、入力欄とスクロールバーを遮らない。 -->
            <Style x:Key="ViewingSpineStyle" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="{Binding TitleSpineVisibility}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=TitleEditBox}" Value="Visible">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            CornerRadius="{Binding NoteCornerRadius}"
            ToolTip="{Binding ReminderTooltip}"
            SizeChanged="RootBorder_SizeChanged"
            Background="{Binding BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{Binding NoteBorderBrush}"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave"
            PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="RootBorder_PreviewMouseLeftButtonUp"
            MouseMove="RootBorder_MouseMove"
            LostMouseCapture="RootBorder_LostMouseCapture">
        <Grid x:Name="NoteSurface" SizeChanged="NoteSurface_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- タイトルバー -->
                <RowDefinition Height="*"/>    <!-- コンテンツ -->
            </Grid.RowDefinitions>

            <!-- タイトルバー：閉じた表示/開いた表示ボタン + タイトル -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0" Height="{Binding TitleBarHeight}" Background="{Binding TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                  MouseEnter="TitleBar_MouseEnter"
                  MouseLeave="TitleBar_MouseLeave"
                  PreviewMouseWheel="TitleBar_PreviewMouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 右端の余白。ボタンはウィンドウ枠の中でもクリックを受けるので、
                         リサイズ枠に重なると右端をつかめる所がほとんど残らない。
                         幅はリサイズ枠より少し広く、ApplySettings で合わせる。 -->
                    <ColumnDefinition x:Name="TitleBarEndGap" Width="6"/>
                </Grid.ColumnDefinitions>

                <!-- WPFのTextBlockはカラーフォントを描画しないため、
                     Segoe UI Emojiを画像化して表示する -->
                <Image x:Name="IconImage"
                       Grid.Column="0"
                       Visibility="{Binding IconVisibility}"
                       Width="{Binding TitleIconSize}"
                       Height="{Binding TitleIconSize}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       ToolTip="{Binding TitleIconTooltip}">
                    <Image.Effect>
                        <!-- A centered, narrow shadow outlines the alpha silhouette. -->
                        <DropShadowEffect Color="#263238" ShadowDepth="0"
                                          BlurRadius="1.5" Opacity="0.55"
                                          RenderingBias="Quality"/>
                    </Image.Effect>
                </Image>

                <!-- 編集中の持ち手。タイトル入力欄の上は掴めないので、アイコンが
                     無い付箋では入力欄がタイトルバーを埋めると動かせなくなる。
                     アイコンがあればそちらが持ち手になるので、無いときだけ出す。
                     押した処理はタイトルバーへそのまま流れる。 -->
                <Border x:Name="TitleGripHandle"
                        Grid.Column="0"
                        Width="14"
                        Margin="3,0,0,0"
                        Background="Transparent"
                        Cursor="SizeAll">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Visibility, ElementName=TitleEditBox}" Value="Visible"/>
                                        <Condition Binding="{Binding Visibility, ElementName=IconImage}" Value="Collapsed"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Data="M0,0h2v2h-2z M4,0h2v2h-2z M0,4h2v2h-2z M4,4h2v2h-2z M0,8h2v2h-2z M4,8h2v2h-2z"
                          Fill="{Binding TitleBarForeground}"
                          Opacity="0.55"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"/>
                </Border>

                <!-- タイトル表示（Title があればそれを、無ければ本文1行目を表示）。
                     閉じた表示/開いた表示にかかわらず常に表示する -->
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Text="{Binding TitleBarDisplayText}"
                           Foreground="{Binding TitleBarForeground}"
                           FontWeight="Normal"
                           FontSize="{Binding TitleFontSize}"
                           VerticalAlignment="Center"
                           Margin="{Binding TitleTextMargin}"
                           ToolTip="{Binding TitleTooltip}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 外部ファイルの変更を確かめている間、確認のたびにゆっくり薄くなる丸。
                     場所は外部ファイルの付箋で常に空けておき、止まったら透明にするだけにする
                     （出たり消えたりでタイトルの文字がずれないように）。 -->
                <Ellipse x:Name="ExternalPollingIndicator"
                         Grid.Column="1"
                         Width="6" Height="6"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"
                         Fill="{Binding TitleBarForeground}"
                         Visibility="{Binding ExternalPollingIndicatorVisibility}"
                         Opacity="0"
                         IsHitTestVisible="False"/>

                <!-- タイトル直接入力欄。編集モード中だけ表示する
                     （EnterEditMode/EnterViewMode で切り替え）。
                     空欄のままなら DisplayTitle は本文1行目にフォールバックする。
                     幅は文字に合わせ、残りはタイトルバーの持ち手として空けておく
                     （空いた所のクリックはこの欄へのフォーカスになる）。 -->
                <TextBox x:Name="TitleEditBox"
                         Grid.Column="1"
                         HorizontalAlignment="Left"
                         MinWidth="48"
                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"
                         Background="Transparent"
                         Foreground="{Binding TitleBarForeground}"
                         CaretBrush="{Binding TitleBarForeground}"
                         BorderThickness="0"
                         FontWeight="Normal"
                         FontSize="{Binding TitleFontSize}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Margin="4,0,4,0"
                         Padding="0"
                         ToolTip="空欄なら本文の1行目を表示します"
                         GotKeyboardFocus="EditableControl_GotKeyboardFocus"
                         TextChanged="TitleEditBox_TextChanged"
                         LostKeyboardFocus="TitleEditBox_LostKeyboardFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown"/>

                <!-- リマインダー設定中の状態表示。ホバーで予定時刻を確認できる。 -->
                <TextBlock Grid.Column="2"
                           Text="{x:Static services:UiIcons.Clock}"
                           FontFamily="{x:Static services:UiIcons.Font}"
                           Visibility="{Binding ReminderVisibility}"
                           ToolTip="{Binding ReminderTooltip}"
                           Foreground="{Binding TitleBarForeground}"
                           Opacity="0.82"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="2,0,3,0"/>

                <!-- 編集ロック中の状態表示。クリック対象にしないことで、
                     タイトルバーのドラッグや表示切り替え操作を邪魔しない。 -->
                <TextBlock Grid.Column="3"
                           Text="{x:Static services:UiIcons.Lock}"
                           FontFamily="{x:Static services:UiIcons.Font}"
                           Visibility="{Binding EditLockVisibility}"
                           Foreground="{Binding TitleBarForeground}"
                           Opacity="0.75"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="2,0,3,0"
                           IsHitTestVisible="False"/>

                <Grid Grid.Column="4"
                      Width="13" Height="13"
                      Visibility="{Binding PositionSeparatedVisibility}"
                      ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=PositionSeparatedTooltip}"
                      Opacity="0.82"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="2,0,3,0"
                      IsHitTestVisible="False">
                    <!-- 切れたリンク。フォントに無いので、リンクの字に斜線を重ねる。 -->
                    <TextBlock Text="{x:Static services:UiIcons.Link}" FontFamily="{x:Static services:UiIcons.Font}" FontSize="12"
                               Foreground="{Binding TitleBarForeground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Line X1="2" Y1="2" X2="11" Y2="11" Stroke="{Binding TitleBarForeground}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>

                <!-- tail 表示中の状態表示。末尾へ追従していることが
                     本文を見なくても分かるようにする。 -->
                <TextBlock x:Name="TailModeIndicator"
                           Grid.Column="5"
                           Text="{x:Static services:UiIcons.ToEnd}"
                           FontFamily="{x:Static services:UiIcons.Font}"
                           Visibility="{Binding TailModeVisibility}"
                           ToolTip="{Binding TailModeTooltip}"
                           Foreground="{Binding TitleBarForeground}"
                           Opacity="0.82"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="2,0,3,0"/>

                <!-- 新規作成。閲覧モードのままでも付箋を増やせるようにする -->
                <Button x:Name="AddNoteButton"
                        Grid.Column="6" Content="{x:Static services:UiIcons.Add}"
                        FontFamily="{x:Static services:UiIcons.Font}"
                        Style="{StaticResource TitleBarButtonOnLight}"
                        ToolTip="新しい付箋を追加"
                        Click="AddNote_Click"/>

                <!-- 常に最前面。閲覧モードや閉じた表示でも状態が見えるよう
                     ステータスバーではなくタイトルバーに置く -->
                <ToggleButton x:Name="PinButton"
                              Grid.Column="7"
                              IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                              Style="{StaticResource TitleBarToggleOnLight}"
                              ToolTip="常に最前面"
                              Content="{x:Static services:UiIcons.Pin}"
                              FontFamily="{x:Static services:UiIcons.Font}"
                              Checked="Pin_Changed" Unchecked="Pin_Changed"/>

                <Button x:Name="FoldButton"
                        Grid.Column="8" Content="{Binding FoldIcon}"
                        FontFamily="{x:Static services:UiIcons.Font}"
                        Style="{StaticResource TitleBarButtonOnLight}"
                        ToolTip="折りたたむ / 展開する"
                        Click="Fold_Click"/>
            </Grid>

            <!-- コンテンツエリア -->
            <RichTextBox x:Name="ContentBox"
                         Grid.Row="1"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         Foreground="{Binding TextForeground}" CaretBrush="{Binding TextForeground}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="{Binding NoteContentPadding}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Cursor="Arrow"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.ScrollChanged="Content_ScrollChanged"
                         TextChanged="ContentBox_TextChanged"
                         ContextMenuOpening="ContentBox_ContextMenuOpening"
                         GotKeyboardFocus="EditableControl_GotKeyboardFocus"
                         PreviewMouseLeftButtonDown="ContentBox_PreviewMouseDown"
                         PreviewMouseRightButtonDown="ContentBox_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="ContentBox_PreviewMouseRightButtonUp"
                         PreviewMouseWheel="ContentBox_PreviewMouseWheel"
                         MouseMove="ContentBox_MouseMove"
                         LostMouseCapture="ContentBox_LostMouseCapture"
                         LostKeyboardFocus="ContentBox_LostKeyboardFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                    <!-- 本文の中だけに効かせる。ポップアップの一覧はテーマ側の配色のままにする。 -->
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource NoteScrollBar}"/>
                </RichTextBox.Resources>
            </RichTextBox>

            <Border x:Name="FoldedPreviewHost" Grid.Row="1" Visibility="Collapsed"
                    Background="Transparent" Padding="{Binding NoteContentPadding}" ClipToBounds="True"
                    ContextMenuOpening="TitleContextMenuOpening"
                    PreviewMouseWheel="TitleBar_PreviewMouseWheel">
                <TextBlock x:Name="FoldedPreviewText" FontFamily="{Binding FontFamily}"
                           FontSize="{Binding TitleFontSize}" Foreground="{Binding TextForeground}"
                           Margin="5,0,5,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Border>

            <!-- 編集中、本文の終わりから下を少しだけ濃くして、どこまでが文章かを見せる。
                 BodyEditBox は背景が透けるので手前ではなく後ろに敷く。上端は
                 UpdateEndOfTextShade が最終行に合わせる（.EditMode.cs）。 -->
            <Border x:Name="EndOfTextShade"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Background="{Binding EndOfTextShadeBrush}"/>

            <TextBox x:Name="BodyEditBox"
                     Grid.Row="1"
                     FontFamily="{Binding FontFamily}"
                     FontSize="{Binding FontSize}"
                     Foreground="{Binding TextForeground}" CaretBrush="{Binding TextForeground}"
                     Background="Transparent"
                     BorderThickness="0"
                     BorderBrush="Transparent"
                     FocusVisualStyle="{x:Null}"
                     Padding="{Binding NoteEditorPadding}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.ScrollChanged="Content_ScrollChanged"
                     SizeChanged="BodyEditBox_SizeChanged"
                     Visibility="Collapsed"
                     GotKeyboardFocus="EditableControl_GotKeyboardFocus"
                     TextChanged="BodyEditBox_TextChanged" PreviewMouseWheel="ContentBox_PreviewMouseWheel"
                     ContextMenuOpening="BodyEditBox_ContextMenuOpening"
                     LostKeyboardFocus="BodyEditBox_LostKeyboardFocus"
                     PreviewKeyDown="ContentBox_PreviewKeyDown">
                <TextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource NoteScrollBar}"/>
                </TextBox.Resources>
            </TextBox>

            <!-- フォントサイズ変更時だけ現れて消える表示。
                 ContentBox より後に置いて手前に重ねる -->
            <!-- タイトルバーを隠しているときの代替。本文の上に重ねて右上に出し、
                 ホバー中だけ表示する。別HWNDのPopupにすると開いた瞬間に
                 ウィンドウが非アクティブになるため、同じウィンドウ内の要素にする。
                 左側の余白はウィンドウ移動のつまみ代を兼ねる。 -->
            <Grid x:Name="TitleBarOverlay"
                  Grid.Row="1"
                  Visibility="Collapsed"
                  Panel.ZIndex="20"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,4,4,0"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <!-- 枠と塗りはホバー中だけ。アイコンだけ出しているときに帯があると
                     本文に貼り付いた札のように見えるため。付箋の色に追従させたいので
                     バインディングを持つ要素を分け、表示の切り替えだけをコード側で行う。 -->
                <Border x:Name="TitleBarOverlayBackdrop"
                        Visibility="Collapsed"
                        CornerRadius="6"
                        Background="{Binding TitleBarBrush}"
                        BorderBrush="{Binding HeaderBrush}"
                        BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="6,1,3,1">
                    <!-- ホバー中だけ出す部分。アイコンより左に並べることで、
                         出入りしてもアイコンの位置が動かない。 -->
                    <StackPanel x:Name="TitleBarOverlayActions"
                                Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                    <TextBlock Text="{x:Static services:UiIcons.Clock}" FontFamily="{x:Static services:UiIcons.Font}"
                               Visibility="{Binding ReminderVisibility}"
                               ToolTip="{Binding ReminderTooltip}"
                               Foreground="{Binding TitleBarForeground}"
                               Opacity="0.82" VerticalAlignment="Center"
                               FontSize="12" Margin="2,0,3,0"/>
                    <TextBlock Text="{x:Static services:UiIcons.Lock}" FontFamily="{x:Static services:UiIcons.Font}"
                               Visibility="{Binding EditLockVisibility}"
                               Foreground="{Binding TitleBarForeground}"
                               Opacity="0.75" VerticalAlignment="Center"
                               FontSize="12" Margin="2,0,3,0"
                               IsHitTestVisible="False"/>
                    <Grid Width="13" Height="13"
                          Visibility="{Binding PositionSeparatedVisibility}"
                          ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=PositionSeparatedTooltip}"
                          Opacity="0.82" VerticalAlignment="Center"
                          Margin="2,0,3,0"
                          IsHitTestVisible="False">
                        <TextBlock Text="{x:Static services:UiIcons.Link}" FontFamily="{x:Static services:UiIcons.Font}" FontSize="12"
                                   Foreground="{Binding TitleBarForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Line X1="2" Y1="2" X2="11" Y2="11" Stroke="{Binding TitleBarForeground}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <Button x:Name="OverlayAddNoteButton" Content="{x:Static services:UiIcons.Add}" FontFamily="{x:Static services:UiIcons.Font}"
                            Style="{StaticResource TitleBarButtonOnLight}"
                            ToolTip="新しい付箋を追加"
                            Click="AddNote_Click"/>
                    <ToggleButton x:Name="OverlayPinButton"
                                  IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                  Style="{StaticResource TitleBarToggleOnLight}"
                                  ToolTip="常に最前面"
                                  Content="{x:Static services:UiIcons.Pin}" FontFamily="{x:Static services:UiIcons.Font}"
                                  Checked="Pin_Changed" Unchecked="Pin_Changed"/>
                    <Button x:Name="OverlayFoldButton" Content="{Binding FoldIcon}" FontFamily="{x:Static services:UiIcons.Font}"
                            Style="{StaticResource TitleBarButtonOnLight}"
                            ToolTip="折りたたむ / 展開する"
                            Click="Fold_Click"/>
                    </StackPanel>

                    <!-- 1行表示のときは、これだけが付箋の見分けになるので出しておく。 -->
                    <Image x:Name="OverlayIconImage"
                           Visibility="{Binding IconVisibility}"
                           Width="{Binding TitleIconSize}"
                           Height="{Binding TitleIconSize}"
                           Stretch="Uniform" VerticalAlignment="Center"
                           Margin="3,0,0,0"
                           ToolTip="{Binding TitleIconTooltip}"/>

                    <!-- アイコンが無いとつかむ所が数ピクセルの余白しか残らず、
                         付箋を動かせない。代わりの持ち手を右端に出す。
                         四方向の矢印にしているのは、左端の ＋（新規作成）と
                         見分けが付かなくなるため。
                         クリックは親のGridまで上がり、そこのドラッグ処理が動く。 -->
                    <TextBlock x:Name="OverlayMoveHandle"
                               Visibility="Collapsed"
                               Text="{x:Static services:UiIcons.Move}"
                               FontFamily="{x:Static services:UiIcons.Font}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="3,0,1,0"
                               Foreground="{Binding TitleBarForeground}"
                               ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MoveNoteTooltip}"/>
                </StackPanel>
            </Grid>

            <!-- タイトルバーを隠している付箋の目印。畳んで1行になると、タイトルバーを
                 出している付箋との違いがアイコンの左右だけになり見分けが付かない
                 （タイトル未設定なら DisplayTitle が本文1行目に落ちるので、
                 出ている文字まで同じになる）。色や不透明度に左右されない形の
                 手掛かりとして左端に縦線を出す。当たり判定は持たせない
                 ―― 本文のドラッグと左端の幅リサイズを邪魔しないため。
                 既定では端から少し離して本文との間に浮かせる（TitleSpineMargin）。
                 従来どおり端に貼り付けたいときは設定で戻せる。
                 掴んで動かす当たり判定は、下に敷いた透明な板が引き受ける
                 （帯そのものは細すぎて狙えない）。 -->
            <Border x:Name="TitleBarHiddenSpineHandle"
                    Grid.Row="0" Grid.RowSpan="2"
                    Style="{StaticResource ViewingSpineStyle}"
                    Panel.ZIndex="14"
                    Background="Transparent"
                    Cursor="SizeAll"
                    HorizontalAlignment="Left"
                    Margin="0"
                    Width="{Binding TitleSpineHandleWidth}"
                    ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MoveNoteTooltip}"
                    MouseLeftButtonDown="SpineHandle_MouseLeftButtonDown"
                    MouseMove="SpineHandle_MouseMove"
                    MouseLeftButtonUp="SpineHandle_MouseLeftButtonUp"
                    LostMouseCapture="SpineHandle_LostMouseCapture"/>

            <Rectangle x:Name="TitleBarHiddenSpine"
                       Grid.Row="0" Grid.RowSpan="2"
                       Style="{StaticResource ViewingSpineStyle}"
                       Panel.ZIndex="15"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       Margin="{Binding TitleSpineMargin}"
                       Width="{Binding TitleSpineWidth}"
                       RadiusX="{Binding TitleSpineCornerRadius}"
                       RadiusY="{Binding TitleSpineCornerRadius}"
                       Fill="{Binding HeaderBrush}"/>

            <!-- リマインダーは付箋全体を点滅させる。塗りは半透明にして、本文が透けて読めるようにする。 -->
            <Border x:Name="ReminderFlashBorder" Grid.RowSpan="2" Panel.ZIndex="100"
                    BorderBrush="#FF9800" BorderThickness="4" Background="#73FF9800"
                    CornerRadius="{Binding NoteFlashCornerRadius}"
                    Opacity="0" IsHitTestVisible="False"/>

            <!-- 外部ファイルが更新されたときに1回だけ光る枠。リマインダーの
                 点滅（オレンジ・太め・10秒）と取り違えないよう、色も太さも変えてある。
                 ERROR / FATAL が届いたときは、コードから塗りを足して付箋全体を点滅させる。 -->
            <!-- 畳んだ位置の影（FoldedPositionGhost）にマウスが乗っているあいだ、どの付箋の影かを示す縁取り。 -->
            <Border x:Name="FoldedGhostHighlight" Grid.RowSpan="2" Panel.ZIndex="98"
                    BorderBrush="#808080" BorderThickness="2"
                    CornerRadius="{Binding NoteFlashCornerRadius}"
                    Opacity="0" IsHitTestVisible="False"/>

            <Border x:Name="UpdateFlashBorder" Grid.RowSpan="2" Panel.ZIndex="99"
                    BorderBrush="#40C4FF" BorderThickness="2"
                    CornerRadius="{Binding NoteFlashCornerRadius}"
                    Opacity="0" IsHitTestVisible="False"/>

            <Border x:Name="SizeOverlay"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#D0000000"
                    CornerRadius="6"
                    Padding="14,8"
                    IsHitTestVisible="False"
                    Opacity="0">
                <TextBlock x:Name="SizeOverlayText"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- 編集ツールバー。編集モード中は常に表示する -->
            <!-- 編集中であることの唯一の目印。ツールバーはフォーカスが外れると
                 隠れるので、これが無いと編集中かどうか分からない。付箋の色に
                 左右されないよう塗りと反対色のフチを持たせ、本文のクリックを
                 邪魔しないよう当たり判定は持たせない。 -->
            <Border x:Name="EditingBadge"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Panel.ZIndex="31"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="6,0,0,6"
                    Padding="7,2,7,2"
                    CornerRadius="4"
                    Background="Black"
                    BorderBrush="White"
                    BorderThickness="1">
                <TextBlock x:Name="EditingBadgeText"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- 編集を確定するボタン。ツールバーはフォーカスが外れると隠れるので、
                 そこに置くと編集を終える手段まで一緒に消えてしまう。編集中は
                 常に出ている「編集中」の反対側、付箋の右下に置く。
                 Focusable を切るのは、押した瞬間に本文からフォーカスが移って
                 カーソル位置や選択が乱れるのを避けるため。 -->
            <Button x:Name="DoneEditingButton"
                    Grid.Row="1"
                    Content="{x:Static services:UiIcons.CheckMark}"
                    FontFamily="{x:Static services:UiIcons.Font}"
                    Visibility="Collapsed"
                    Panel.ZIndex="31"
                    Focusable="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="36" Height="36" FontSize="16"
                    Margin="0,0,10,10"
                    Style="{StaticResource DoneEditingToolbarButton}"
                    ToolTip="編集を確定"
                    Click="DoneEditing_Click"/>

            <Popup x:Name="EditToolbarPopup"
                   Opened="EditToolbarPopup_Opened"
                   PlacementTarget="{Binding ElementName=RootBorder}"
                   Placement="Bottom"
                   HorizontalOffset="4"
                   VerticalOffset="2"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Border x:Name="StatusBar"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="3"
                        MouseEnter="EditToolbar_MouseEnter"
                        MouseLeave="EditToolbar_MouseLeave">
                    <!-- 文字色は地の色と同じくテーマで決まるので、ShowEditToolbar が
                         StatusBar に流し込む色をそのまま継承させる（付箋本文の色で
                         上書きすると、濃い付箋＋ライトテーマで読めなくなる）。 -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UndoButton" Content="{x:Static services:UiIcons.Undo}" FontFamily="{x:Static services:UiIcons.Font}" FontSize="16" Style="{StaticResource EditToolbarButton}"
                                Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=BodyEditBox}"/>
                        <Button x:Name="RedoButton" Content="{x:Static services:UiIcons.Redo}" FontFamily="{x:Static services:UiIcons.Font}" FontSize="16" Style="{StaticResource EditToolbarButton}"
                                Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=BodyEditBox}"/>
                        <Button x:Name="FontLargerButton" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding FontSize, StringFormat=本文のフォントを大きく (現在 {0}pt)}"
                                Click="FontLarger_Click"/>
                        <TextBlock Text="{Binding FontSize, StringFormat={}{0:0.#}}"
                                   MinWidth="22" Margin="2,0" FontSize="12" Opacity="0.75"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   IsHitTestVisible="False" Focusable="False"/>
                        <Button x:Name="FontSmallerButton" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding FontSize, StringFormat=本文のフォントを小さく (現在 {0}pt)}"
                                Click="FontSmaller_Click"/>
                        <Border Width="1" Height="16" Margin="5,0" VerticalAlignment="Center"
                                Background="{Binding BorderBrush, ElementName=StatusBar}" IsHitTestVisible="False"/>
                        <Button x:Name="TitleLargerButton" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding TitleFontSize, StringFormat=タイトルのフォントを大きく (現在 {0}pt)}"
                                Click="TitleLarger_Click"/>
                        <TextBlock Text="{Binding TitleFontSize, StringFormat={}{0:0.#}}"
                                   MinWidth="22" Margin="2,0" FontSize="12" Opacity="0.75"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   IsHitTestVisible="False" Focusable="False"/>
                        <Button x:Name="TitleSmallerButton" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding TitleFontSize, StringFormat=タイトルのフォントを小さく (現在 {0}pt)}"
                                Click="TitleSmaller_Click"/>
                        <Border Width="1" Height="16" Margin="5,0" VerticalAlignment="Center"
                                Background="{Binding BorderBrush, ElementName=StatusBar}" IsHitTestVisible="False"/>
                        <Button x:Name="FontButton" Content="Aa" Width="24"
                                Style="{StaticResource EditToolbarButton}"
                                ToolTip="フォントを変更" Click="Font_Click"/>
                        <Button x:Name="IconButton" Content="{x:Static services:UiIcons.Emoji}"
                                FontFamily="{x:Static services:UiIcons.Font}" FontSize="16"
                                Style="{StaticResource EditToolbarButton}"
                                ToolTip="アイコンを変更"
                                Click="Icon_Click"/>
                        <Button x:Name="ColorButton" Content="{x:Static services:UiIcons.Palette}"
                                FontFamily="{x:Static services:UiIcons.Font}" FontSize="16"
                                Style="{StaticResource EditToolbarButton}"
                                ToolTip="色を変更"
                                Click="Color_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 本文の編集中に文字を選ぶと、選んだ文字のそばに出る書式ツールバー。
                 ボタンは .FormatToolbar.cs が作る（ツールチップを言語に合わせるため）。 -->
            <Popup x:Name="FormatToolbarPopup"
                   Opened="FormatToolbarPopup_Opened"
                   PlacementTarget="{Binding ElementName=BodyEditBox}"
                   Placement="Custom"
                   StaysOpen="True"
                   AllowsTransparency="True">
                <Border x:Name="FormatBar"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="2">
                    <StackPanel x:Name="FormatBarButtons" Orientation="Horizontal"/>
                </Border>
            </Popup>

            <!-- 閉じた表示でホバーすると本文を確認できるプレビュー。タイトルバーを
                 隠しているときはそこが Collapsed で位置が取れないため、常に
                 表示されている RootBorder を基準にする（畳んだ表示では
                 どちらの場合も RootBorder の下端＝見えている行の下端になる）。 -->
            <Popup x:Name="TitlePreviewPopup"
                   PlacementTarget="{Binding ElementName=RootBorder}"
                   Placement="Bottom"
                   HorizontalOffset="1"
                   VerticalOffset="2"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   IsHitTestVisible="False"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Border Background="{Binding BackgroundBrush}"
                        BorderBrush="{Binding HeaderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Opacity="0.78"
                        MaxWidth="360">
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding TitleBarForeground}"
                                   FontFamily="{Binding FontFamily}"
                                   FontSize="{Binding FontSize}"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>

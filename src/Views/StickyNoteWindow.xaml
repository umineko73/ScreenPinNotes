<Window x:Class="ScreenPinNotes.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinWidth="140" MinHeight="28"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScreenPinNotes;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            SizeChanged="RootBorder_SizeChanged"
            Background="{Binding BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{Binding HeaderBrush}"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- タイトルバー -->
                <RowDefinition Height="*"/>    <!-- コンテンツ -->
            </Grid.RowDefinitions>

            <!-- タイトルバー：閉じた表示/開いた表示ボタン + タイトル -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0" Height="{Binding TitleBarHeight}" Background="{Binding TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                  MouseEnter="TitleBar_MouseEnter"
                  MouseLeave="TitleBar_MouseLeave"
                  PreviewMouseWheel="TitleBar_PreviewMouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- WPFのTextBlockはカラーフォントを描画しないため、
                     Segoe UI Emojiを画像化して表示する -->
                <Image x:Name="IconImage"
                       Grid.Column="0"
                       Visibility="{Binding IconVisibility}"
                       Width="{Binding TitleIconSize}"
                       Height="{Binding TitleIconSize}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       ToolTip="{Binding TitleIconTooltip}">
                    <Image.Effect>
                        <!-- A centered, narrow shadow outlines the alpha silhouette. -->
                        <DropShadowEffect Color="#263238" ShadowDepth="0"
                                          BlurRadius="1.5" Opacity="0.55"
                                          RenderingBias="Quality"/>
                    </Image.Effect>
                </Image>

                <!-- タイトル表示（Title があればそれを、無ければ本文1行目を表示）。
                     閉じた表示/開いた表示にかかわらず常に表示する -->
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Text="{Binding DisplayTitle}"
                           Foreground="{Binding TitleBarForeground}"
                           FontWeight="Normal"
                           FontSize="{Binding TitleFontSize}"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           ToolTip="{Binding TitleTooltip}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- タイトル直接入力欄。編集モード中だけ表示する
                     （EnterEditMode/EnterViewMode で切り替え）。
                     空欄のままなら DisplayTitle は本文1行目にフォールバックする -->
                <TextBox x:Name="TitleEditBox"
                         Grid.Column="1"
                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"
                         Background="Transparent"
                         Foreground="{Binding TitleBarForeground}"
                         CaretBrush="{Binding TitleBarForeground}"
                         BorderThickness="0"
                         FontWeight="Normal"
                         FontSize="{Binding TitleFontSize}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Margin="4,0,4,0"
                         Padding="0"
                         InputMethod.IsInputMethodEnabled="True"
                         InputMethod.PreferredImeState="On"
                         InputMethod.PreferredImeConversionMode="Native, FullShape"
                         ToolTip="空欄なら本文の1行目を表示します"
                         GotKeyboardFocus="EditableControl_GotKeyboardFocus"
                         TextChanged="TitleEditBox_TextChanged"
                         LostKeyboardFocus="TitleEditBox_LostKeyboardFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown"/>

                <!-- リマインダー設定中の状態表示。ホバーで予定時刻を確認できる。 -->
                <TextBlock Grid.Column="2"
                           Text="⏰"
                           Visibility="{Binding ReminderVisibility}"
                           ToolTip="{Binding ReminderTooltip}"
                           Foreground="{Binding TitleBarForeground}"
                           Opacity="0.82"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="2,0,3,0"/>

                <!-- 編集ロック中の状態表示。クリック対象にしないことで、
                     タイトルバーのドラッグや表示切り替え操作を邪魔しない。 -->
                <TextBlock Grid.Column="3"
                           Text="🔒"
                           Visibility="{Binding EditLockVisibility}"
                           Foreground="{Binding TitleBarForeground}"
                           Opacity="0.75"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="2,0,3,0"
                           IsHitTestVisible="False"/>

                <TextBlock Grid.Column="4"
                           Text="⛓️‍💥"
                           Visibility="{Binding PositionSeparatedVisibility}"
                           ToolTip="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=PositionSeparatedTooltip}"
                           Foreground="{Binding TitleBarForeground}"
                           Opacity="0.82"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="2,0,3,0"
                           IsHitTestVisible="False"/>

                <!-- 新規作成。閲覧モードのままでも付箋を増やせるようにする -->
                <Button x:Name="AddNoteButton"
                        Grid.Column="5" Content="＋"
                        Style="{StaticResource TitleBarButtonOnLight}"
                        ToolTip="新しい付箋を追加"
                        Click="AddNote_Click"/>

                <!-- 常に最前面。閲覧モードや閉じた表示でも状態が見えるよう
                     ステータスバーではなくタイトルバーに置く -->
                <ToggleButton x:Name="PinButton"
                              Grid.Column="6"
                              IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                              Style="{StaticResource TitleBarToggleOnLight}"
                              ToolTip="常に最前面"
                              Content="📌"
                              Checked="Pin_Changed" Unchecked="Pin_Changed"/>

                <Button x:Name="FoldButton"
                        Grid.Column="7" Content="{Binding FoldIcon}"
                        Margin="0,0,2,0"
                        Style="{StaticResource TitleBarButtonOnLight}"
                        ToolTip="折りたたむ / 展開する"
                        Click="Fold_Click"/>
            </Grid>

            <!-- コンテンツエリア -->
            <RichTextBox x:Name="ContentBox"
                         Grid.Row="1"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         Foreground="{Binding TextForeground}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         InputMethod.IsInputMethodEnabled="True"
                         InputMethod.PreferredImeState="On"
                         InputMethod.PreferredImeConversionMode="Native, FullShape"
                         Cursor="Arrow"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="ContentBox_TextChanged"
                         ContextMenuOpening="ContentBox_ContextMenuOpening"
                         GotKeyboardFocus="EditableControl_GotKeyboardFocus"
                         PreviewMouseLeftButtonDown="ContentBox_PreviewMouseDown"
                         PreviewMouseRightButtonDown="ContentBox_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="ContentBox_PreviewMouseRightButtonUp"
                         PreviewMouseWheel="ContentBox_PreviewMouseWheel"
                         MouseMove="ContentBox_MouseMove"
                         LostMouseCapture="ContentBox_LostMouseCapture"
                         LostKeyboardFocus="ContentBox_LostKeyboardFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

            <TextBox x:Name="BodyEditBox"
                     Grid.Row="1"
                     FontFamily="{Binding FontFamily}"
                     FontSize="{Binding FontSize}"
                     Foreground="{Binding TextForeground}"
                     Background="Transparent"
                     BorderThickness="2"
                     BorderBrush="CornflowerBlue"
                     Padding="8"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Visibility="Collapsed"
                     InputMethod.IsInputMethodEnabled="True"
                     InputMethod.PreferredImeState="On"
                     InputMethod.PreferredImeConversionMode="Native, FullShape"
                     GotKeyboardFocus="EditableControl_GotKeyboardFocus"
                     TextChanged="BodyEditBox_TextChanged"
                     ContextMenuOpening="BodyEditBox_ContextMenuOpening"
                     LostKeyboardFocus="BodyEditBox_LostKeyboardFocus"
                     PreviewKeyDown="ContentBox_PreviewKeyDown"/>

            <!-- フォントサイズ変更時だけ現れて消える表示。
                 ContentBox より後に置いて手前に重ねる -->
            <Border x:Name="SizeOverlay"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#D0000000"
                    CornerRadius="6"
                    Padding="14,8"
                    IsHitTestVisible="False"
                    Opacity="0">
                <TextBlock x:Name="SizeOverlayText"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- 編集ツールバー。編集モード中は常に表示する -->
            <Popup x:Name="EditToolbarPopup"
                   Opened="EditToolbarPopup_Opened"
                   PlacementTarget="{Binding ElementName=RootBorder}"
                   Placement="Bottom"
                   HorizontalOffset="4"
                   VerticalOffset="2"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Border x:Name="StatusBar"
                        Background="{StaticResource NoteToolbarBackground}"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="3"
                        MouseEnter="EditToolbar_MouseEnter"
                        MouseLeave="EditToolbar_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FontSmallerButton" Content="A-" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding FontSize, StringFormat=本文のフォントを小さく (現在 {0}pt)}"
                                Click="FontSmaller_Click"/>
                        <Button x:Name="FontLargerButton" Content="A+" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding FontSize, StringFormat=本文のフォントを大きく (現在 {0}pt)}"
                                Click="FontLarger_Click"/>
                        <Button x:Name="TitleSmallerButton" Content="T-" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding TitleFontSize, StringFormat=タイトルのフォントを小さく (現在 {0}pt)}"
                                Click="TitleSmaller_Click"/>
                        <Button x:Name="TitleLargerButton" Content="T+" Style="{StaticResource EditToolbarButton}"
                                ToolTip="{Binding TitleFontSize, StringFormat=タイトルのフォントを大きく (現在 {0}pt)}"
                                Click="TitleLarger_Click"/>
                        <Button x:Name="FontButton" Content="Aa"
                                Style="{StaticResource EditToolbarButton}"
                                ToolTip="フォントを変更" Click="Font_Click"/>
                        <Button x:Name="IconButton" Content="🦊"
                                Style="{StaticResource EditToolbarButton}"
                                ToolTip="アイコンを変更"
                                Click="Icon_Click"/>
                        <Button x:Name="ColorButton" Content="🎨"
                                Style="{StaticResource EditToolbarButton}"
                                ToolTip="色を変更"
                                Click="Color_Click"/>
                        <Button x:Name="DoneEditingButton" Content="✓"
                                Style="{StaticResource DoneEditingToolbarButton}"
                                ToolTip="編集を確定" Click="DoneEditing_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 閉じた表示でタイトルバーにホバーすると本文を確認できるプレビュー -->
            <Popup x:Name="TitlePreviewPopup"
                   PlacementTarget="{Binding ElementName=TitleBar}"
                   Placement="Bottom"
                   HorizontalOffset="1"
                   VerticalOffset="2"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   IsHitTestVisible="False"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Border Background="{Binding BackgroundBrush}"
                        BorderBrush="{Binding HeaderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Opacity="0.78"
                        MaxWidth="360">
                    <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding TitleBarForeground}"
                                   FontFamily="{Binding FontFamily}"
                                   FontSize="{Binding FontSize}"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>

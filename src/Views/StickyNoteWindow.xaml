<Window x:Class="ScreenStickyNotes.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        MinWidth="140" MinHeight="28"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{Binding BackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{Binding HeaderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- タイトルバー -->
                <RowDefinition Height="*"/>    <!-- コンテンツ -->
                <RowDefinition Height="Auto"/> <!-- ステータスバー（編集モード時） -->
            </Grid.RowDefinitions>

            <!-- タイトルバー：折りたたみボタン + 折りたたみ時タイトル -->
            <Grid Grid.Row="0" Height="{Binding TitleBarHeight}" Background="{Binding HeaderBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- アイコン（未設定なら非表示）。
                     WPF はカラーフォントを描画しないため白抜きのシルエットになる -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Icon}"
                           Visibility="{Binding IconVisibility}"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

                <!-- タイトル（1行目）は折りたたみ状態にかかわらず常に表示 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding FirstLine}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="{Binding TitleFontSize}"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 新規作成。閲覧モードのままでも付箋を増やせるようにする -->
                <Button Grid.Column="2" Content="＋"
                        Style="{StaticResource TitleBarButton}"
                        ToolTip="新しい付箋を追加"
                        Click="AddNote_Click"/>

                <!-- 常に最前面。閲覧モードや折りたたみ時も状態が見えるよう
                     ステータスバーではなくタイトルバーに置く -->
                <ToggleButton Grid.Column="3"
                              IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                              Style="{StaticResource TitleBarToggle}"
                              ToolTip="常に最前面"
                              Content="📌"
                              Checked="Pin_Changed" Unchecked="Pin_Changed"/>

                <Button Grid.Column="4" Content="{Binding FoldIcon}"
                        Margin="0,0,2,0"
                        Style="{StaticResource TitleBarButton}"
                        ToolTip="折りたたみ / 展開"
                        Click="Fold_Click"/>
            </Grid>

            <!-- コンテンツエリア -->
            <RichTextBox x:Name="ContentBox"
                         Grid.Row="1"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         IsReadOnly="True"
                         Cursor="Arrow"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ContentBox_TextChanged"
                         ContextMenuOpening="ContentBox_ContextMenuOpening"
                         PreviewMouseLeftButtonDown="ContentBox_PreviewMouseDown"
                         MouseMove="ContentBox_MouseMove"
                         LostKeyboardFocus="ContentBox_LostKeyboardFocus"
                         PreviewKeyDown="ContentBox_PreviewKeyDown">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

            <!-- フォントサイズ変更時だけ現れて消える表示。
                 ContentBox より後に置いて手前に重ねる -->
            <Border x:Name="SizeOverlay"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#D0000000"
                    CornerRadius="6"
                    Padding="14,8"
                    IsHitTestVisible="False"
                    Opacity="0">
                <TextBlock x:Name="SizeOverlayText"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- ステータスバー（編集モード時のみ表示） -->
            <Border x:Name="StatusBar"
                    Grid.Row="2"
                    Background="{Binding HeaderBrush}"
                    Visibility="Collapsed">
                <DockPanel Margin="2,1">
                    <!-- 右端：削除ボタン -->
                    <Button DockPanel.Dock="Right"
                            Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="削除" Click="Close_Click"/>
                    <!-- 左側：操作ボタン群（幅が狭いときは折り返す） -->
                    <WrapPanel>
                        <Button Content="A-" Style="{StaticResource TitleBarButton}"
                                ToolTip="{Binding FontSize, StringFormat=本文のフォントを小さく (現在 {0}pt)}"
                                Click="FontSmaller_Click"/>
                        <Button Content="A+" Style="{StaticResource TitleBarButton}"
                                ToolTip="{Binding FontSize, StringFormat=本文のフォントを大きく (現在 {0}pt)}"
                                Click="FontLarger_Click"/>
                        <Button Content="T-" Style="{StaticResource TitleBarButton}"
                                ToolTip="{Binding TitleFontSize, StringFormat=タイトルのフォントを小さく (現在 {0}pt)}"
                                Click="TitleSmaller_Click"/>
                        <Button Content="T+" Style="{StaticResource TitleBarButton}"
                                ToolTip="{Binding TitleFontSize, StringFormat=タイトルのフォントを大きく (現在 {0}pt)}"
                                Click="TitleLarger_Click"/>
                        <Button x:Name="FontButton" Content="Aa"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="フォントを変更" Click="Font_Click"/>
                        <Button x:Name="IconButton" Content="😀"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="アイコンを変更" Click="Icon_Click"/>
                        <Button x:Name="ColorButton" Content="🎨"
                                Style="{StaticResource TitleBarButton}"
                                ToolTip="色を変更" Click="Color_Click"/>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

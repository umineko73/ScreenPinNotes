<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenStickyNotes</AssemblyName>
    <RootNamespace>ScreenStickyNotes</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.0.1</Version>
    <Authors>umineko73</Authors>
    <Product>ScreenStickyNotes</Product>
    <Description>Windows 11 向けのデスクトップ付箋アプリ</Description>
    <Copyright>Copyright (C) 2026 umineko73</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/umineko73/ScreenStickyNotes</RepositoryUrl>
  </PropertyGroup>
</Project>
